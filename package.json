{
  "name": "tilt-breaker",
  "description": "Daily per-time-class game quota for chess.com",
  "private": true,
  "version": "1.7.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "icons": "node scripts/make-icons.mjs",
    "test": "TZ=Europe/Madrid vitest run",
    "smoke": "wxt build && node scripts/smoke-options.mjs",
    "screenshots": "wxt build && node scripts/make-screenshots.mjs",
    "test:watch": "TZ=Europe/Madrid vitest",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@wxt-dev/i18n": "^0.2.7",
    "@wxt-dev/module-svelte": "^2.0.4",
    "happy-dom": "^20.11.2",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.53.7",
    "svelte-check": "^4.4.4",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  }
}
